{
  "name": "claudemd-doctor",
  "version": "0.1.0",
  "description": "Audit your CLAUDE.md: real token cost per turn, dead rules, and conflicts for Claude Code. Offline, no API key.",
  "keywords": [
    "claude",
    "claude-code",
    "claude-md",
    "tokens",
    "cost",
    "llm",
    "ai-agents",
    "anthropic",
    "cli",
    "context-window"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/awesomo913/claudemd-doctor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awesomo913/claudemd-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/awesomo913/claudemd-doctor/issues"
  },
  "author": "awesomo913",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "claudemd-doctor": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "demo": "npm run build && node dist/cli.js --home demo/home --cwd D:\\demo-project"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.15",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
